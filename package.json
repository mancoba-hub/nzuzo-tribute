{
  "name": "nzuzo-tribute",
  "version": "1.0.0",
  "private": true,
  "description": "Tribute collection app for Nzuzo Pukuza - organised by Qeqe Community Development",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4",
    "vite": "^7.0.0"
  }
}
