# Admin password for the tribute dashboard (set this before going live!)
ADMIN_PASSWORD=change-this-password

# Port the server listens on (optional, default 3001)
PORT=3001

# Cloudflare R2 permanent storage (free, recommended).
# Without these, tributes and photos are only stored on the local disk
# and are lost on Render's free tier when the service redeploys or sleeps.
# See README.md → "Permanent storage with Cloudflare R2 (free)".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nzuzo-tribute
